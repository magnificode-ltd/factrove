{
  "$schema": "https://mintlify.com/docs.json",
  "name": "Factrove",
  "theme": "mint",
  "description": "Guides and references for Factrove. Self-host the server, or use Factrove Cloud.",
  "seo": {
    "metatags": {
      "canonical": "https://factrove.mintlify.app"
    }
  },
  "colors": {
    "primary": "#5e64d6",
    "light": "#858bee",
    "dark": "#5055b6"
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Overview",
        "icon": "book-open",
        "groups": [
          {
            "group": "Start",
            "pages": [
              "introduction",
              "concepts"
            ]
          },
          {
            "group": "Guides",
            "pages": [
              "guides/cli",
              "guides/sharing-links",
              "guides/troubleshooting"
            ]
          }
        ]
      },
      {
        "tab": "Self-host",
        "icon": "server",
        "groups": [
          {
            "group": "Self-host",
            "pages": [
              "self-host/quickstart",
              "self-host/deploy",
              "self-host/configuration"
            ]
          }
        ]
      },
      {
        "tab": "Factrove Cloud",
        "icon": "cloud",
        "groups": [
          {
            "group": "Factrove Cloud",
            "pages": [
              "cloud/quickstart"
            ]
          }
        ]
      },
      {
        "tab": "CLI reference",
        "groups": [
          {
            "group": "Commands",
            "pages": [
              "cli-reference/overview",
              "cli-reference/help",
              "cli-reference/upload",
              "cli-reference/get",
              "cli-reference/share",
              "cli-reference/list",
              "cli-reference/rename",
              "cli-reference/delete",
              "cli-reference/configure"
            ]
          }
        ]
      },
      {
        "tab": "API reference",
        "groups": [
          {
            "group": "Overview",
            "pages": [
              "api-reference/overview"
            ]
          }
        ],
        "openapi": "api-reference/openapi.json"
      }
    ]
  },
  "redirects": [
    {
      "source": "/quickstart",
      "destination": "/self-host/quickstart",
      "permanent": true
    },
    {
      "source": "/guides/self-hosting",
      "destination": "/self-host/deploy",
      "permanent": true
    }
  ],
  "api": {
    "openapi": "api-reference/openapi.json",
    "examples": {
      "autogenerate": false
    }
  },
  "markdown": {
    "instructions": "Describe what the running code does. Self-host and Factrove Cloud are different setups. Do not invent hosted pricing, launch dates, or a hosted web origin. The CLI default API origin is https://api.factrove.app. Share and viewer links are a configured base URL plus an artifact path. For a server the reader runs, show localhost and a placeholder origin such as https://library.example.com."
  }
}
