{
  "name": "@factrove/cli",
  "version": "0.1.0",
  "private": true,
  "files": ["dist"],
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "start": "node dist/main.js",
    "dev": "pnpm build && node dist/main.js",
    "test": "pnpm --filter @factrove/cli... build && vitest run"
  },
  "dependencies": {
    "@factrove/api-client": "workspace:*",
    "@nestjs/common": "11.1.9",
    "@nestjs/core": "11.1.9",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  }
}
