# CLI settings for pnpm factrove. Copy to apps/cli/.env.
# scripts/factrove.mjs reads this file. node apps/cli/dist/main.js and the published npm CLI do not.
# The file may set FACTROVE_API_URL and FACTROVE_PROFILE. It does not set an API key.
# API keys belong in ~/.factrove/credentials. factrove configure writes that file mode 0600.
# A value already set in the environment stays in place.
# A URL in this file is used only when FACTROVE_API_URL is unset and the selected profile has no api_url.
# The built-in default origin is https://api.factrove.app.
# This file points pnpm factrove at the local API. The published factrove and ftrv commands do not read it.
# --api-url and --endpoint-url override the origin for one command.
# FACTROVE_ENDPOINT_URL is a process-environment alias. This file does not set it.
# It applies only when FACTROVE_API_URL is unset. A profile may set api_url or endpoint_url.
# api_url wins when both profile keys are set.
# An explicit --profile uses that profile's key and ignores FACTROVE_API_KEY.

FACTROVE_API_URL=http://localhost:3001
# FACTROVE_PROFILE=default
