# CLI settings. Copy to apps/cli/.env.
# The CLI reads this file for FACTROVE_* names that are unset or blank.
# A value already set in the environment stays in place.
# Precedence is flags, then environment variables, then this file, then ~/.factrove profile files.
# --api-url overrides FACTROVE_API_URL. An explicit --profile uses that profile's key and ignores FACTROVE_API_KEY.
# When the API URL is unset everywhere, the default is http://localhost:3001.
# ~/.factrove/credentials holds factrove_api_key. ~/.factrove/config holds api_url.
# factrove configure writes those files. The API key is not printed.

FACTROVE_API_URL=http://localhost:3001
# FACTROVE_API_KEY=
# FACTROVE_PROFILE=default
# FACTROVE_CONFIG_DIR=
# FACTROVE_SHARED_CREDENTIALS_FILE=
# FACTROVE_CONFIG_FILE=
