# Process environment for the Factrove CLI. The CLI does not load this file.
# upload and get both use this origin. --api-url overrides FACTROVE_API_URL.
# When both are unset, the default is http://localhost:3001.
# The same key lives in the root .env.example. pnpm factrove applies that file only when the variable is unset.
FACTROVE_API_URL=http://localhost:3001
