# Application configuration for the API and the web app. Copy to apps/api/.env.
# The API loads this file and keeps values that are already set in the environment.
# pnpm dev passes NEXT_PUBLIC_API_URL from this file to the web app when that variable is unset.
# CLI settings belong in apps/cli/.env.
# DATABASE_URL matches the PostgreSQL service in compose.yaml.
# The S3 settings below match the local Garage service started by pnpm infra:up.
# Garage creates the bucket factrove on startup. The access key and secret are local only.
# To use an existing AWS bucket, set S3_BUCKET and S3_REGION, remove S3_ENDPOINT and
# S3_FORCE_PATH_STYLE, and set AWS_ACCESS_KEY_ID with AWS_SECRET_ACCESS_KEY (or AWS_PROFILE).
# With S3_ENDPOINT unset, the API calls AWS in S3_REGION and ignores AWS_ENDPOINT_URL.
# Plain http:// is accepted only for localhost, 127.0.0.1, and ::1. Use https:// for any other host.
# The API does not create an AWS bucket.
DATABASE_URL=postgresql://factrove:factrove@127.0.0.1:5432/factrove
BASE_URL=http://127.0.0.1:3001
HOST=127.0.0.1
PORT=3001
WEB_ORIGIN=http://localhost:3000
API_PUBLIC_ORIGIN=http://localhost:3001
# Browser origin for API calls from the web app. Defaults to http://localhost:3001 when unset.
NEXT_PUBLIC_API_URL=http://localhost:3001
# Local placeholder. Use at least 32 characters. Do not reuse this value outside local development.
BETTER_AUTH_SECRET=local-only-factrove-auth-secret-change-me
# Parent domain for the session cookie when the web app and API are on different hosts.
# The browser sends this cookie to every subdomain, so use the narrowest parent.
# For app.factrove.example.com and api.factrove.example.com, use factrove.example.com.
# The value must be a domain name rather than an IP or a public suffix, and both
# WEB_ORIGIN and API_PUBLIC_ORIGIN must be that domain or a subdomain of it.
# Leave unset on localhost.
# AUTH_COOKIE_DOMAIN=factrove.example.com
# Reverse proxies that may set X-Forwarded-For, as comma-separated IPs or CIDRs.
# Leave unset when the API sees the client socket directly. A matching peer uses the
# right-most untrusted hop. Any other peer is the client, and X-Forwarded-For is ignored.
# TRUSTED_PROXIES=10.0.0.0/8
S3_BUCKET=factrove
S3_REGION=us-east-1
S3_ENDPOINT=http://127.0.0.1:3900
S3_FORCE_PATH_STYLE=true
AWS_ACCESS_KEY_ID=factrove-local
AWS_SECRET_ACCESS_KEY=factrove-local-secret
# AWS_SESSION_TOKEN=
# AWS_PROFILE=
# S3_INTEGRATION=1
# Markdown conversion workers at once (1-4). Further requests wait, then fail.
MARKDOWN_CONVERSION_CONCURRENCY=2
# Conversions that may wait for a worker (0-8). A full queue is 503 CONVERSION_UNAVAILABLE.
MARKDOWN_CONVERSION_QUEUE=2
