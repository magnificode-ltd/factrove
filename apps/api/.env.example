# API-only configuration. Copy to apps/api/.env.
# The web app and CLI do not read this file.
# DATABASE_URL matches the PostgreSQL service in compose.yaml.
# Set S3_BUCKET and S3_REGION to an existing AWS bucket. The API ignores custom S3 endpoint URLs.
# Set AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY together, or leave them unset and use AWS_PROFILE or the default credential chain.
DATABASE_URL=postgresql://factrove:factrove@127.0.0.1:5432/factrove
BASE_URL=http://127.0.0.1:3001
HOST=127.0.0.1
PORT=3001
WEB_ORIGIN=http://localhost:3000
API_PUBLIC_ORIGIN=http://localhost:3001
LOCAL_USER_ID=local-user
# Leave blank when the local user has no organization.
LOCAL_ORGANIZATION_ID=local-org
S3_BUCKET=your-bucket
S3_REGION=eu-central-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
# AWS_PROFILE=
# S3_INTEGRATION=1
