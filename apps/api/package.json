{
  "name": "@factrove/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "files": ["dist", "prisma"],
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.json",
    "typecheck": "prisma generate && tsc -p tsconfig.json --noEmit",
    "start": "node dist/main.js",
    "dev": "pnpm build && node dist/main.js",
    "test": "prisma generate && node ../../scripts/build-cli-if-needed.mjs && vitest run && NODE_ENV=production vitest run --config vitest.rate-limit.config.ts",
    "db:generate-schema": "prisma generate && auth generate --config ./auth-schema.config.ts --yes",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "pnpm build && node dist/database/seed/seed.js",
    "db:claim-local-artifacts": "pnpm build && node dist/database/seed/claim.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1149.0",
    "@better-auth/api-key": "1.7.7",
    "@better-auth/prisma-adapter": "1.7.7",
    "@factrove/contracts": "workspace:*",
    "@nestjs/common": "11.1.9",
    "@nestjs/core": "11.1.9",
    "@nestjs/platform-express": "11.1.9",
    "@prisma/client": "6.19.0",
    "prisma": "6.19.0",
    "better-auth": "1.7.7",
    "busboy": "1.6.0",
    "express": "5.1.0",
    "nodemailer": "10.2.1",
    "parse5": "7.3.0",
    "psl": "1.15.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@nestjs/testing": "11.1.9",
    "@types/express": "5.0.6",
    "@types/pg": "8.23.1",
    "auth": "1.7.7",
    "markdown-it": "14.1.0",
    "marked": "14.1.4",
    "pg": "8.23.1",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  }
}
