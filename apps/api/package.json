{
  "name": "@factrove/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "prisma generate --schema src/database/prisma/schema.prisma && tsc -p tsconfig.json",
    "typecheck": "prisma generate --schema src/database/prisma/schema.prisma && tsc -p tsconfig.json --noEmit",
    "start": "node dist/main.js",
    "dev": "pnpm build && node dist/main.js",
    "test": "prisma generate --schema src/database/prisma/schema.prisma && vitest run",
    "db:generate-schema": "prisma generate --schema src/database/prisma/schema.prisma && auth generate --config ./auth-schema.config.ts --output src/database/prisma/schema.prisma --yes",
    "db:migrate": "prisma migrate deploy --schema src/database/prisma/schema.prisma",
    "db:seed": "pnpm build && node dist/database/prisma/identities/seed.js"
  },
  "dependencies": {
    "@better-auth/prisma-adapter": "1.7.7",
    "@factrove/contracts": "workspace:*",
    "@nestjs/common": "11.1.9",
    "@nestjs/core": "11.1.9",
    "@nestjs/platform-express": "11.1.9",
    "@prisma/client": "6.19.0",
    "better-auth": "1.7.7",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@types/pg": "8.23.1",
    "auth": "1.7.7",
    "pg": "8.23.1",
    "prisma": "6.19.0",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  }
}
