# HTTP origins for the web app and the CLI. Copy to .env at the repository root.
# pnpm dev passes NEXT_PUBLIC_API_URL to the web app when the variable is not already set.
# pnpm factrove reads FACTROVE_API_URL from the process environment, then from this file.
# --api-url overrides both.
# Database and storage settings belong in apps/api/.env only.

NEXT_PUBLIC_API_URL=http://localhost:3001
FACTROVE_API_URL=http://localhost:3001
