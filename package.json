{
  "name": "factrove",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.25.0",
  "engines": { "node": ">=24.7.0 <25", "pnpm": ">=11.25.0 <12" },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "eslint .",
    "test": "pnpm --filter @factrove/cli... build && FACTROVE_CLI_ALREADY_BUILT=1 pnpm -r --if-present test && node --test scripts/runtime.test.mjs && pnpm docs:check",
    "docs:openapi": "pnpm --filter @factrove/contracts build && node scripts/docs-openapi.mjs",
    "docs:cli": "pnpm --filter @factrove/cli... build && node scripts/docs-cli.mjs",
    "docs:check": "pnpm --filter @factrove/contracts --filter @factrove/cli... build && node scripts/docs-check.mjs",
    "docs:dev": "node scripts/docs-dev.mjs",
    "dev": "node scripts/dev.mjs",
    "infra:up": "node scripts/infra.mjs up",
    "infra:down": "node scripts/infra.mjs down",
    "infra:reset": "node scripts/infra.mjs reset",
    "db:migrate": "pnpm --filter @factrove/api db:migrate",
    "db:seed": "pnpm --filter @factrove/contracts build && pnpm --filter @factrove/api db:seed",
    "db:claim-local-artifacts": "pnpm --filter @factrove/contracts build && pnpm --filter @factrove/api build && node apps/api/dist/database/seed/claim.js",
    "factrove": "node scripts/factrove.mjs",
    "e2e": "node scripts/e2e-local.mjs"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "eslint": "10.12.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1",
    "vitest": "3.2.4"
  }
}
