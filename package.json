{
  "name": "factrove",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.25.0",
  "engines": { "node": ">=24.0.0 <25", "pnpm": ">=11.25.0 <12" },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "eslint .",
    "test": "pnpm -r --if-present test",
    "dev": "node scripts/pending.mjs 'dev stack (Task 07)'",
    "infra:up": "node scripts/pending.mjs 'local services (Task 07)'",
    "infra:down": "node scripts/pending.mjs 'local services (Task 07)'",
    "db:migrate": "pnpm --filter @factrove/api db:migrate",
    "db:seed": "pnpm --filter @factrove/api db:seed",
    "factrove": "pnpm --filter @factrove/cli start"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "eslint": "10.12.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1",
    "vitest": "3.2.4"
  }
}
